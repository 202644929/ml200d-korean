+    }
+
+    struct rbf_ext *ext = malloc(sizeof(struct rbf_ext));
+    if (!ext)
+    {
+        free(buf);
+        return 0;
+    }
+
+    ext->count      = count;
+    ext->cell_bits  = cell_bits;
+    ext->glyph_size = glyph_size;
+    ext->codes      = (uint16_t *)(buf + 8);
+    ext->widths     = (uint8_t *)(buf + 8 + count * 2);
+    ext->bitmaps    = buf + 8 + count * 3;
+    return ext;
