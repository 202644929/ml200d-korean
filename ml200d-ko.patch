+#define KO_OVERRIDES_COUNT ((int)(sizeof(ko_overrides)/sizeof(ko_overrides[0])))
+
+const char* ko_tr(const char* en)
+{
+    if (!en) return en;
+    /* Hangul glyphs (ML/FONTS/<name>.KOX) missing from the card: keep English
+     * instead of drawing blank menu text */
+    if (!rbf_font_has_ext_glyphs()) return en;
+    int lo = 0, hi = KO_OVERRIDES_COUNT - 1;
+    while (lo <= hi)
+    {
+        int mid = (lo + hi) / 2;
+        int c = strcmp(en, ko_overrides[mid].en);
+        if (c == 0) return ko_overrides[mid].ko;
+        else if (c < 0) hi = mid - 1;
+        else lo = mid + 1;
+    }
+    return en;
+}
