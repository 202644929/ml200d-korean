+/* Decode one Unicode codepoint from a UTF-8 byte sequence starting at 's'.
+ * Sets *n to the number of bytes consumed (always >= 1, never reads past
+ * a NUL terminator: each continuation-byte check short-circuits on a 0x00
+ * byte before the next one is read). A lead byte that isn't followed by
+ * valid continuation bytes decodes as a single raw byte (Latin-1 passthrough),
+ * so legacy single-byte non-ASCII fonts/strings keep working unchanged. */
+static inline uint32_t utf8_decode(const char *s, int *n)
+{
+    uint8_t c0 = (uint8_t)s[0];
+
+    if (c0 < 0x80)
+    {
+        *n = 1;
+        return c0;
+    }
+    else if ((c0 & 0xE0) == 0xC0 && ((uint8_t)s[1] & 0xC0) == 0x80)
+    {
+        *n = 2;
+        return ((c0 & 0x1F) << 6) | ((uint8_t)s[1] & 0x3F);
+    }
+    else if ((c0 & 0xF0) == 0xE0 && ((uint8_t)s[1] & 0xC0) == 0x80 && ((uint8_t)s[2] & 0xC0) == 0x80)
+    {
+        *n = 3;
+        return ((c0 & 0x0F) << 12) | (((uint8_t)s[1] & 0x3F) << 6) | ((uint8_t)s[2] & 0x3F);
+    }
+    else if ((c0 & 0xF8) == 0xF0 && ((uint8_t)s[1] & 0xC0) == 0x80 && ((uint8_t)s[2] & 0xC0) == 0x80 && ((uint8_t)s[3] & 0xC0) == 0x80)
+    {
+        *n = 4;
+        return ((c0 & 0x07) << 18) | (((uint8_t)s[1] & 0x3F) << 12) | (((uint8_t)s[2] & 0x3F) << 6) | ((uint8_t)s[3] & 0x3F);
+    }
+
+    *n = 1;
+    return c0;
+}
+
+//-------------------------------------------------------------------
+/* Extension glyphs for codepoints an RBF can't hold (its wTable/cTable only
+ * cover 0-255). Loaded from an optional ML/FONTS/<name>.RBX next to the RBF,
+ * generated by tools/i18n/gen_rbx.py. File layout (little-endian):
+ *   0x00  "RBX1"
+ *   0x04  uint16 count       number of glyphs
+ *   0x06  uint8  height      must equal the RBF height
+ *   0x07  uint8  cell_bits   bitmap row stride in bits (multiple of 8)
+ *   0x08  uint16 codes[count], sorted ascending
+ *         uint8  widths[count], advance in pixels
+ *         bitmaps: count * height * cell_bits/8 bytes, same layout as cTable
+ */
+struct rbf_ext {
+    int count;
+    int cell_bits;
+    int glyph_size;
+    uint16_t *codes;
+    uint8_t *widths;
+    char *bitmaps;
+};
+
+static struct rbf_ext *rbf_ext_load(const char *filename, int font_height);
+
+static int rbf_ext_find(const struct rbf_ext *ext, int ch)
+{
+    int lo = 0, hi = ext->count - 1;
+    while (lo <= hi)
+    {
+        int mid = (lo + hi) / 2;
+        int c = ext->codes[mid];
+        if (c == ch) return mid;
+        if (c < ch) lo = mid + 1;
+        else hi = mid - 1;
+    }
+    return -1;
