+ * valid continuation bytes decodes as a single raw byte (Latin-1 passthrough),
+ * so legacy single-byte non-ASCII fonts/strings keep working unchanged. */
+static inline uint32_t utf8_decode(const char *s, int *n)
+{
+    uint8_t c0 = (uint8_t)s[0];
