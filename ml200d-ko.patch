+//-------------------------------------------------------------------
+// Load extension glyphs from a .RBX file (layout above struct rbf_ext).
+// Returns NULL if the file is missing or doesn't match this font.
+static struct rbf_ext *rbf_ext_load(const char *filename, int font_height)
+{
+    uint32_t size;
+    if ((FIO_GetFileSize(filename, &size) != 0) || (size < 8))
+    {
+        return 0;
+    }
+
+    char *buf = malloc(size);
+    if (!buf)
+    {
+        return 0;
+    }
+
+    FILE *fd = FIO_OpenFile(filename, O_RDONLY | O_SYNC);
+    if (!fd)
+    {
+        free(buf);
+        return 0;
+    }
+    int got = font_read(fd, (unsigned char*)buf, size);
+    FIO_CloseFile(fd);
+
+    const uint8_t *h = (const uint8_t *)buf;
+    int count      = h[4] | (h[5] << 8);
+    int height     = h[6];
+    int cell_bits  = h[7];
+    int glyph_size = height * (cell_bits / 8);
+
+    if (got != (int)size
+        || h[0] != 'R' || h[1] != 'B' || h[2] != 'X' || h[3] != '1'
+        || count == 0 || height != font_height
+        || cell_bits == 0 || (cell_bits % 8) != 0
+        || size < (uint32_t)(8 + count * 3 + count * glyph_size))
