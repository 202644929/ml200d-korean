old mode 100755
new mode 100644
index 164700760..513fe6d23
--- a/platform/200D.101/consts.h
+++ b/platform/200D.101/consts.h
@@ -218,3 +218,11 @@ extern int winsys_bmp_dirty_bit_neg;
 
 //address of XimrContext structure to redraw in FEATURE_VRAM_RGBA
 #define XIMR_CONTEXT 0xa09a0
+
+// Trap Focus on-screen message position/text - missing from this port
+// (every other platform defines these; 200D's consts.h just never got them).
+// Values match 100D/650D/700D/600D (same small-Rebel-body ML overlay canvas).
+#define DISPLAY_TRAP_FOCUS_POS_X 65
+#define DISPLAY_TRAP_FOCUS_POS_Y 360
+#define DISPLAY_TRAP_FOCUS_MSG       "TRAP FOCUS"
+#define DISPLAY_TRAP_FOCUS_MSG_BLANK "          "
diff --git a/platform/200D.101/features.h b/platform/200D.101/features.h
index 36f333a97..67682c306 100644
--- a/platform/200D.101/features.h
+++ b/platform/200D.101/features.h
@@ -40,6 +40,12 @@
 
 #define FEATURE_INTERVALOMETER
 
+// Not yet verified on 200D hardware by the upstream ML community - enabling
+// to test "Advanced Bracket" (N shots per shutter press, incl. 2-shot expo
+// bracketing). Only sets exposure/flash/DOF values per shot, doesn't touch
+// sensor/hardware registers directly, so risk is low, but flag as untested.
+#define FEATURE_HDR_BRACKETING
+
 // Optionally sticky halfshutter.  Works but likely not required.
 //#define FEATURE_STICKY_HALFSHUTTER
 
@@ -51,6 +57,32 @@
 #define FEATURE_GLOBAL_DRAW
 #define FEATURE_CROPMARKS
 
+// Focus peaking (highlights in-focus edges in LiveView). Also not yet
+// verified on 200D - pure overlay/display code, doesn't touch sensor
+// registers, so low risk, but untested on this platform.
+#define FEATURE_FOCUS_PEAK
+
+// Core exposure/composition overlay tools. These were surprisingly absent
+// from this port even though they are among ML's most basic, most commonly
+// used features elsewhere (zebra stripes, histogram, spot meter, waveform,
+// vectorscope, false color, electronic level). All pure display/overlay
+// code, no sensor/hardware register access, so low risk - but like the
+// other additions above, not yet verified on real 200D hardware.
+#define FEATURE_ZEBRA
+// NOTE: FEATURE_ZEBRA_FAST deliberately NOT enabled - it needs
+// FEATURE_COLOR_SCHEME, which writes directly to an LCD_Palette hardware
+// register. That register is for older indexed-palette display hardware;
+// 200D uses FEATURE_VRAM_RGBA (true RGBA framebuffer) instead, so poking
+// that register here would be a real hardware risk, not just untested code.
+#define FEATURE_HISTOGRAM
+#define FEATURE_RAW_HISTOGRAM
+#define FEATURE_SPOTMETER
+#define FEATURE_RAW_SPOTMETER
+#define FEATURE_WAVEFORM
+#define FEATURE_VECTORSCOPE
+#define FEATURE_FALSE_COLOR
+#define FEATURE_LEVEL_INDICATOR
+
 // Enable remapping ROM pages to RAM
 #define CONFIG_SGI_HANDLERS
 #define CONFIG_MMU_REMAP
@@ -74,3 +106,109 @@
 #define CONFIG_AUTOBACKUP_ROM
 
 #undef CONFIG_ADDITIONAL_VERSION
+
+// --- Batch 3: broader sweep of remaining photo-workflow / LiveView-display /
+// playback features not yet tried. Pure software/UI features expected; will
+// build and check for link errors (hardware-register dependencies) same as
+// the zebra/histogram batch above, and prune anything that comes back risky.
+// FEATURE_TRAP_FOCUS: was missing DISPLAY_TRAP_FOCUS_POS_X/Y and
+// DISPLAY_TRAP_FOCUS_MSG/_BLANK - added them to consts.h (every other
+// platform defines these; 200D's consts.h just never got them). Re-enabled.
+#define FEATURE_TRAP_FOCUS
+#define FEATURE_BULB_TIMER
+#define FEATURE_BULB_TIMER_SHOW_PREVIOUS_PIC
+#define FEATURE_MOTION_DETECT
+// FEATURE_VOICE_TAGS removed: references handle_voice_tags/voice_tags,
+// undefined for 200D - upstream itself keeps this double-commented-out
+// (disabled even in the master all_features.h list) everywhere.
+#define FEATURE_FLASH_TWEAKS
+#define FEATURE_FLASH_NOFLASH
+#define FEATURE_LV_3RD_PARTY_FLASH
+#define FEATURE_AF_PATTERNS
+#define FEATURE_FOCUS_STACKING
+#define FEATURE_FOLLOW_FOCUS
+#define FEATURE_MLU
+#define FEATURE_MLU_HANDHELD
+#define FEATURE_STICKY_DOF
+#define FEATURE_EXPO_LOCK
+#define FEATURE_EXPO_OVERRIDE
+#define FEATURE_EXPO_PRESET
+#define FEATURE_EXPO_ISO
+#define FEATURE_EXPO_SHUTTER
+#define FEATURE_EXPO_APERTURE
+// FEATURE_EXPSIM removed: needs CONFIG_EXPSIM (a lower-level capability flag
+// 200D's port doesn't define), not just FEATURE_EXPSIM - without it,
+// expsim_toggle/expsim_display are never defined and the menu entry that
+// references them fails to compile.
+#define FEATURE_WARNINGS_FOR_BAD_SETTINGS
+// FEATURE_QUICK_ZOOM removed: references IMGPLAY_ZOOM_LEVEL_MAX, a hardware
+// buffer/register constant not defined for 200D - incompletely ported here.
+#define FEATURE_QUICK_ERASE
+#define FEATURE_SNAP_SIM
+// FEATURE_PLAY_COMPARE_IMAGES / FEATURE_PLAY_EXPOSURE_FUSION removed: both
+// reference YUV422_HD_BUFFER_1/2, a fixed buffer address not defined for
+// 200D's display pipeline.
+#define FEATURE_PLAY_EXPOSURE_ADJUST
+#define FEATURE_PLAY_TIMELAPSE
+#define FEATURE_IMAGE_REVIEW_PLAY
+#define FEATURE_SET_MAINDIAL
+#define FEATURE_SWAP_INFO_PLAY
+#define FEATURE_SWAP_MENU_ERASE
+// FEATURE_UNMOUNT_SD_CARD removed: references FSUunMountDevice, undefined
+// for 200D - also double-commented-out by upstream everywhere.
+#define FEATURE_CLEAR_OVERLAYS
+#define FEATURE_LV_DISPLAY_GAIN
+#define FEATURE_LV_BRIGHTNESS_CONTRAST
+#define FEATURE_LV_SATURATION
+#define FEATURE_LV_ZOOM_SETTINGS
+// FEATURE_LV_ZOOM_AUTO_EXPOSURE removed: also needs CONFIG_EXPSIM (same
+// missing subsystem as FEATURE_EXPSIM above).
+#define FEATURE_LV_ZOOM_SHARP_CONTRAST
+#define FEATURE_LV_FOCUS_BOX_AUTOHIDE
+#define FEATURE_LV_FOCUS_BOX_FAST
+#define FEATURE_LV_FOCUS_BOX_SNAP
+#define FEATURE_LV_BUTTON_RATE
+#define FEATURE_LV_BUTTON_RATE_UPDOWN
+#define FEATURE_LV_BUTTON_PROTECT
+#define FEATURE_LV_DISPLAY_PRESETS
+#define FEATURE_MAGIC_ZOOM
+#define FEATURE_GHOST_IMAGE
